{
  "name": "OpenBMC Build - Ubuntu 26.04",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "options": ["--network=host"],
    "args": {
      "UBUNTU_VERSION": "26.04",
    }
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "runArgs": [
    "--cap-add=sys_admin",
    "--cap-add=sys_nice",
    "--network=host"
  ]
}
